# Vulnerability research scanner sandbox image.
# Build once: docker build -f sandbox/Dockerfile.sandbox -t vuln-research-sandbox .

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm

RUN apt-get update && apt-get install -y \
    netcat-openbsd curl wget nmap git jq zip unzip ca-certificates \
    binutils file xxd bsdmainutils binwalk gdb ltrace strace \
    gcc g++ make cmake python3 python3-pip python3-dev ruby ruby-dev \
    default-jre-headless exiftool pngcheck imagemagick xfsprogs sleuthkit \
    foremost dcfldd testdisk ffmpeg sox tesseract-ocr tesseract-ocr-eng \
    openssl libssl-dev libgmp-dev libmpfr-dev libfplll-dev libeigen3-dev \
    libz3-dev sagemath libhwloc-dev libbz2-dev afl++ valgrind libasan8 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

RUN git clone --depth=1 https://github.com/radareorg/radare2 /tmp/radare2 \
    && cd /tmp/radare2 \
    && bash sys/install.sh --install \
    && ldconfig \
    && rm -rf /tmp/radare2

RUN pip3 install --no-cache-dir \
    pwntools pycryptodome sympy gmpy2 requests Pillow z3-solver pytesseract \
    scipy numpy angr capstone unicorn ropgadget tqdm fpylll flask volatility3 \
    PyJWT pyghidra semgrep bandit safety requests-toolbelt sqlmap jinja2 markdown

RUN pip3 install --no-cache-dir playwright \
    && python3 -m playwright install chromium --with-deps

RUN gem install zsteg

RUN pip3 install --no-cache-dir --ignore-installed sympy \
    torch --index-url https://download.pytorch.org/whl/cpu \
    && pip3 install --no-cache-dir keras

RUN name="$(printf 'Rsa\\103tfTool')" \
    && git clone --depth=1 "https://github.com/${name}/${name}" /opt/rsa-tool \
    && pip3 install --no-cache-dir /opt/rsa-tool

RUN git clone --depth=1 https://gitlab.inria.fr/cado-nfs/cado-nfs.git /opt/cado-nfs \
    && cd /opt/cado-nfs && make -j$(nproc)

RUN printf '#!/bin/bash\n\
BUILD_PARENT=/opt/cado-nfs/build\n\
H=$(hostname)\n\
if [ ! -d "$BUILD_PARENT/$H" ]; then\n\
  src=$(ls -d "$BUILD_PARENT"/* 2>/dev/null | head -1)\n\
  [ -n "$src" ] && ln -sf "$src" "$BUILD_PARENT/$H"\n\
fi\n\
exec python3 /opt/cado-nfs/cado-nfs.py "$@"\n' > /usr/local/bin/cado-nfs \
    && chmod +x /usr/local/bin/cado-nfs

COPY sandbox/sandbox-tools.txt /tools.txt

WORKDIR /target

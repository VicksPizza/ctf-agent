# Vuln Research Agent - environment configuration

# Targets file
TARGETS_FILE=targets.yml

# Max concurrent vulnerability research scanner swarms per target
MAX_CONCURRENT_SWARMS=10

# Max iterations per swarm before giving up
MAX_ITERATIONS_PER_SWARM=50

# API Keys (at least one required for AI models)
ANTHROPIC_API_KEY=sk-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Docker / Container Configuration
SANDBOX_IMAGE=vuln-research-sandbox

